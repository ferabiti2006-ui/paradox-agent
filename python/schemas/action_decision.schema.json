{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paradox-agent.local/schemas/action-decision-v1.json",
  "title": "Paradox Agent validated decision V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "decision_id",
    "observation_date",
    "state_fingerprint",
    "manager",
    "policy",
    "objective",
    "actions",
    "confidence",
    "expected_effect",
    "execution"
  ],
  "properties": {
    "schema": { "const": 1 },
    "decision_id": { "type": "string", "pattern": "^[0-9a-f]{24}$" },
    "observation_date": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}$" },
    "state_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "manager": { "enum": ["routine", "strategic", "war"] },
    "policy": { "type": "string", "minLength": 1 },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "components", "weights", "survival_constraint_satisfied", "risk_flags"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "components": { "$ref": "#/$defs/objectiveValues" },
        "weights": { "$ref": "#/$defs/objectiveValues" },
        "survival_constraint_satisfied": { "type": "boolean" },
        "risk_flags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/waitAction" },
          { "$ref": "#/$defs/chooseResearchAction" },
          { "$ref": "#/$defs/buildDistrictAction" },
          { "$ref": "#/$defs/buildBuildingAction" }
        ]
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "expected_effect": { "$ref": "#/$defs/effectValues" },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "const": "not_executed" },
        "reason": { "const": "game_action_adapter_not_enabled" }
      }
    }
  },
  "$defs": {
    "objectiveValues": {
      "type": "object",
      "additionalProperties": false,
      "required": ["economy", "survival", "technology", "military", "territory"],
      "properties": {
        "economy": { "type": "number", "minimum": 0, "maximum": 1 },
        "survival": { "type": "number", "minimum": 0, "maximum": 1 },
        "technology": { "type": "number", "minimum": 0, "maximum": 1 },
        "military": { "type": "number", "minimum": 0, "maximum": 1 },
        "territory": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "effectValues": {
      "type": "object",
      "additionalProperties": false,
      "required": ["economy", "survival", "technology", "military", "territory"],
      "properties": {
        "economy": { "type": "number", "minimum": -1, "maximum": 1 },
        "survival": { "type": "number", "minimum": -1, "maximum": 1 },
        "technology": { "type": "number", "minimum": -1, "maximum": 1 },
        "military": { "type": "number", "minimum": -1, "maximum": 1 },
        "territory": { "type": "number", "minimum": -1, "maximum": 1 }
      }
    },
    "waitAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "months"],
      "properties": {
        "type": { "const": "WAIT" },
        "months": { "type": "integer", "minimum": 1, "maximum": 12 }
      }
    },
    "chooseResearchAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "area", "technology_id"],
      "properties": {
        "type": { "const": "CHOOSE_RESEARCH" },
        "area": { "enum": ["physics", "society", "engineering"] },
        "technology_id": { "type": "string", "minLength": 1 }
      }
    },
    "buildDistrictAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "planet_id", "district"],
      "properties": {
        "type": { "const": "BUILD_DISTRICT" },
        "planet_id": { "type": "integer", "minimum": 0 },
        "district": {
          "enum": ["district_city", "district_generator", "district_mining", "district_farming"]
        }
      }
    },
    "buildBuildingAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "planet_id", "building"],
      "properties": {
        "type": { "const": "BUILD_BUILDING" },
        "planet_id": { "type": "integer", "minimum": 0 },
        "building": {
          "enum": [
            "building_research_lab_1",
            "building_holo_theatres",
            "building_foundry_1",
            "building_factory_1",
            "building_bureaucratic_1"
          ]
        }
      }
    }
  }
}
